# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string
DATABASE_URL="postgresql://hostelerp:hostelerp_pass@localhost:5432/hostelerp_db?schema=public"

# REDIS_URL: Redis connection string
REDIS_URL="redis://localhost:6379"

# JWT_SECRET: Secret key for signing JWT tokens
JWT_SECRET="hostelerp_enterprise_jwt_secret_key_2026_production"

# VERIFACTU_SOFTWARE_LICENSE: Certificate license for AEAT anti-fraud software
VERIFACTU_SOFTWARE_LICENSE="AEAT-CERT-HOSTELERP-2026-ESP"
